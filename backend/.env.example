# Preencha com seus valores. Nunca use credenciais reais neste arquivo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional: caminho do arquivo SQLite (padrão: data/smartmarket.db)
# DB_PATH=/app/data/smartmarket.db

CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Redis usado pelo rate limiting. O Docker Compose configura o endereço interno.
RATELIMIT_STORAGE_URI=redis://rate-limiter:6379/0
CHAT_RATE_LIMIT=10 per minute; 60 per hour

# Admin inicial: criado uma única vez no primeiro início, se ainda não existir.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Gere um segredo aleatório com pelo menos 32 caracteres. Necessário para login administrativo.
ADMIN_TOKEN_SECRET=
